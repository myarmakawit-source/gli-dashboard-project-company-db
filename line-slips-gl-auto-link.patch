+  /* ---------- CSV ---------- */
+  function csv(name,head,body2){
+    var q=function(s){return '"'+(''+(s==null?'':s)).replace(/"/g,'""')+'"';};
+    var L=[head.map(q).join(',')];
+    for(var i=0;i<body2.length;i++)L.push(body2[i].map(q).join(','));
+    var blob=new Blob(['﻿'+L.join('\r\n')],{type:'text/csv;charset=utf-8'});
+    var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;
+    document.body.appendChild(a);a.click();
+    setTimeout(function(){URL.revokeObjectURL(a.href);a.remove();},1200);
+    toast('ส่งออก '+body2.length.toLocaleString()+' แถวแล้ว');
+  }
+
+  /* ---------- import GL rows into the slip book ---------- */
+  function glKey(r){return 'gl:'+(r[0]||'')+':'+(r[4]||'')+':'+(r[3]||'')+':'+r2(r[16])+':'+r2(r[17]);}
+  function lnGlKeys(){
+    var S=lnState(),o={};
+    for(var i=0;i<S.txns.length;i++)if(S.txns[i]&&S.txns[i].glKey)o[S.txns[i].glKey]=1;
+    return o;
+  }
+  function countImported(){var S=lnState(),n=0;for(var i=0;i<S.txns.length;i++)if(S.txns[i]&&S.txns[i].glKey)n++;return n;}
+  function toTxn(g,rev){
+    var r=g.r,acc=rev[g.acc]||g.acc,pj=(''+(r[13]||'')).trim();
+    var nm=projName(pj);
+    return {
+      id:'lngl'+Date.now().toString(36)+Math.random().toString(36).slice(2,7),
+      dir:g.dir, acc:acc, payee:(''+(r[5]||r[8]||'-')).slice(0,160), taxid:(''+(r[6]||'')),
+      projName:(nm||pj||''), base:g.amt, hasVat:false, vat:0, whtRate:0, wht:0, gross:g.amt, cash:g.amt,
+      inv:!!r[9], invNo:(''+(r[9]||'')), note:('GL '+(r[4]||'')+(r[8]?(' · '+r[8]):'')+(r[15]?(' · '+r[15]):'')).slice(0,400),
+      slipAmt:'', slipRef:(''+(r[9]||r[4]||'')), slipDate:(''+(r[3]||'')),
+      status:'approved', by:'GL · '+((glMeta()&&glMeta().src)||'dashboard'), approver:'',
+      at:((''+(r[3]||'')).slice(0,10)||new Date().toISOString().slice(0,10))+'T00:00:00.000Z',
+      glKey:glKey(r), glAcc:g.acc, glVch:(''+(r[4]||''))
+    };
+  }
+  function importRows(list){
+    if(lnRemote()){toast('โหมดเซิร์ฟเวอร์: นำเข้าผ่านระบบต้นทาง');return;}
+    var S=lnState(),have=lnGlKeys(),rev=revMap(),add=0;
+    for(var i=0;i<list.length;i++){
+      var g=list[i],k=glKey(g.r);
+      if(have[k])continue;
+      have[k]=1;S.txns.push(toTxn(g,rev));add++;
+    }
+    if(!add){toast('ไม่มีรายการใหม่ให้นำเข้า');return;}
+    lnWrite(S,'นำเข้า '+add+' รายการจาก GL เข้าสมุดสลิปแล้ว');
+  }
